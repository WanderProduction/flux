{
  "name": "flux",
  "version": "0.0.36",
  "private": true,
  "type": "module",
  "description": "A keyboard-driven media engine - timeline and node graph as two lenses on one project.",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5273 && electron .",
    "dev:debug": "wait-on tcp:127.0.0.1:5273 && electron . --remote-debugging-port=9222",
    "build": "tsc --noEmit && vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "cli": "node scripts/install-cli.mjs",
    "uncli": "node scripts/install-cli.mjs --uninstall",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "register": "node scripts/register-file-type.mjs",
    "unregister": "node scripts/register-file-type.mjs --unregister",
    "verify:fs": "node scripts/verify-filesystem.mjs",
    "verify:project-fs": "node scripts/verify-project-fs.mjs",
    "verify:project": "node scripts/verify-project.mjs",
    "verify:app": "node scripts/verify-renderer.mjs",
    "verify:tree": "node scripts/verify-tree.mjs",
    "verify:timeline": "node scripts/verify-timeline.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "verify:playback": "node scripts/verify-playback.mjs",
    "verify:demux": "node scripts/verify-demux.mjs",
    "verify:footage": "node scripts/verify-footage.mjs",
    "verify:batch": "node scripts/verify-batch.mjs",
    "verify:render": "node scripts/verify-render.mjs",
    "verify:queue": "node scripts/verify-queue.mjs",
    "verify:render-queue": "node scripts/verify-render-queue.mjs",
    "verify:sequence-render": "node scripts/verify-sequence-render.mjs",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "serve:updates": "node scripts/serve-updates.mjs",
    "verify:update": "node scripts/verify-update.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "dockview": "^4.9.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "dev.flux.app",
    "productName": "FLUX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "build/icon.*",
      "build/document.*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.video"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo"
    },
    "fileAssociations": [
      {
        "ext": "flux",
        "name": "FLUX Project",
        "description": "FLUX project document",
        "icon": "build/document.ico",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1:8911/",
        "channel": "latest"
      }
    ]
  },
  "author": "WanderProduction"
}
