{
  "name": "flux",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A keyboard-driven media engine - timeline and node graph as two lenses on one project.",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5273 && electron .",
    "dev:debug": "wait-on tcp:127.0.0.1:5273 && electron . --remote-debugging-port=9222",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify:fs": "node scripts/verify-filesystem.mjs",
    "verify:project-fs": "node scripts/verify-project-fs.mjs",
    "verify:project": "node scripts/verify-project.mjs",
    "verify:app": "node scripts/verify-renderer.mjs",
    "verify:tree": "node scripts/verify-tree.mjs",
    "verify:timeline": "node scripts/verify-timeline.mjs"
  },
  "dependencies": {
    "dockview": "^4.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^38.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^9.0.0"
  }
}
